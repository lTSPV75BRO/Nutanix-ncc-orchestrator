<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <!--
    Place setup-ncc.ps1 at C:\NCC\setup-ncc.ps1 before running Sysprep.
    Customize NCC_* environment variables in the command below, then run:
      sysprep /generalize /oobe /shutdown /unattend:C:\NCC\Unattend.xml
  -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Deployment"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
          Order="1">
          <Description>Install NCC Orchestrator v2</Description>
          <Path>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$env:NCC_VERSION='2.2.0'; $env:NCC_RELEASE_BASE_URL='https://github.com/lTSPV75BRO/Nutanix-ncc-orchestrator/releases/download'; $env:NCC_CLUSTERS=''; $env:NCC_PCS=''; $env:NCC_USERNAME='admin'; $env:NCC_PASSWORD='CHANGE_ME'; &amp; 'C:\NCC\setup-ncc.ps1'"</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
</unattend>
