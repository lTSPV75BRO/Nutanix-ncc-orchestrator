# Fast UI image. Context is binaryGO.txt's staging dir (binary + frontend-dist).
FROM alpine:3.24

ARG TARGETARCH=amd64
ARG VERSION=dev
ARG STREAM=Release
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="ncc-ui-server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.ncc-orchestrator.stream="${STREAM}"

COPY ncc-host-cas.pem /tmp/ncc-host-cas.pem
# Host CAs are appended only for this apk call (corporate TLS inspection).
# apk's ca-certificates trigger rebuilds the bundle from public roots, so the
# extra CA is not left in the image.
RUN cp /etc/ssl/certs/ca-certificates.crt /tmp/ca.orig \
    && if [ -s /tmp/ncc-host-cas.pem ]; then cat /tmp/ncc-host-cas.pem >> /etc/ssl/certs/ca-certificates.crt; fi \
    && apk add --no-cache ca-certificates tzdata wget \
    && cp /tmp/ca.orig /etc/ssl/certs/ca-certificates.crt \
    && rm -f /tmp/ncc-host-cas.pem /tmp/ca.orig

WORKDIR /app

COPY ncc-ui-server-linux-${TARGETARCH} /usr/local/bin/ncc-ui-server
COPY frontend-dist /app/frontend/dist

RUN chmod 0755 /usr/local/bin/ncc-ui-server \
    && mkdir -p /app/data/auth \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/ncc-ui-server"]
CMD ["--listen", ":8080", "--dir", "/app/frontend/dist", "--backend-url", "http://ncc-api-server:8081", "--api-token-file", "/app/data/auth/.ncc-api-token", "--api-auth-mode", "token", "--allowed-origins", "http://localhost:8080"]
