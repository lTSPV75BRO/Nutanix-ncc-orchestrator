# Fast runner image. Build context is the staging dir produced by binaryGO.txt
# (binaries already linked with -X main.Stream and the rest of the release ldflags).
FROM alpine:3.24

ARG TARGETARCH=amd64
ARG VERSION=dev
ARG STREAM=Release
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="ncc-orchestrator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.ncc-orchestrator.stream="${STREAM}"

RUN apk add --no-cache ca-certificates tzdata

COPY ncc-orchestrator-linux-${TARGETARCH} /usr/local/bin/ncc-orchestrator
RUN chmod 0755 /usr/local/bin/ncc-orchestrator

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ncc-orchestrator"]
CMD ["--config", "/config/config.yaml"]
