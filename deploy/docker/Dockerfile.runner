# Fast runner image. Build context is the staging dir produced by binaryGO.txt
# (binaries already linked with -X main.Stream and the rest of the release ldflags).
FROM alpine:3.24

ARG TARGETARCH=amd64
ARG VERSION=dev
ARG STREAM=Release
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="ncc-orchestrator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.ncc-orchestrator.stream="${STREAM}"

COPY ncc-host-cas.pem /tmp/ncc-host-cas.pem
# Host CAs are appended only for this apk call (corporate TLS inspection).
# apk's ca-certificates trigger rebuilds the bundle from public roots, so the
# extra CA is not left in the image.
RUN cp /etc/ssl/certs/ca-certificates.crt /tmp/ca.orig \
    && if [ -s /tmp/ncc-host-cas.pem ]; then cat /tmp/ncc-host-cas.pem >> /etc/ssl/certs/ca-certificates.crt; fi \
    && apk add --no-cache ca-certificates tzdata \
    && cp /tmp/ca.orig /etc/ssl/certs/ca-certificates.crt \
    && rm -f /tmp/ncc-host-cas.pem /tmp/ca.orig

COPY ncc-orchestrator-linux-${TARGETARCH} /usr/local/bin/ncc-orchestrator
RUN chmod 0755 /usr/local/bin/ncc-orchestrator

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ncc-orchestrator"]
CMD ["--config", "/config/config.yaml"]
