# Fast API image. Context is binaryGO.txt's staging dir.
# Includes ncc-orchestrator because the API pod stages that binary for runs.
FROM alpine:3.24

ARG TARGETARCH=amd64
ARG VERSION=dev
ARG STREAM=Release
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="ncc-api-server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.ncc-orchestrator.stream="${STREAM}"

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY ncc-api-server-linux-${TARGETARCH} /usr/local/bin/ncc-api-server
COPY ncc-orchestrator-linux-${TARGETARCH} /usr/local/bin/ncc-orchestrator

RUN chmod 0755 /usr/local/bin/ncc-api-server /usr/local/bin/ncc-orchestrator \
    && mkdir -p /app/data/auth /app/outputfiles /app/nccfiles /app/logs /app/config \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/usr/local/bin/ncc-api-server", "--health-check", "--listen", "127.0.0.1:8081", "--token-file-path", "/app/data/auth/.ncc-api-token"]

ENTRYPOINT ["/usr/local/bin/ncc-api-server"]
CMD ["--listen", ":8081", "--repo-root", "/app", "--config-path", "/app/config/config.yaml", "--output-dir", "/app/outputfiles", "--log-dir", "/app/nccfiles", "--runner-log-path", "/app/logs/ncc-runner.log", "--token-file-path", "/app/data/auth/.ncc-api-token", "--users-db", "/app/data/auth/.ncc-api-users.json", "--orchestrator-bin", "/usr/local/bin/ncc-orchestrator", "--auth-mode", "token", "--cors-origin", "http://localhost:8080"]
