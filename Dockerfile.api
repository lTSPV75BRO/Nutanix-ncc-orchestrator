FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git
ARG TARGETOS=linux
ARG TARGETARCH=amd64

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/ncc-api-server ./cmd/ncc-api-server
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/ncc-orchestrator .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /out/ncc-api-server /usr/local/bin/ncc-api-server
COPY --from=builder /out/ncc-orchestrator /usr/local/bin/ncc-orchestrator

RUN chmod 0755 /usr/local/bin/ncc-api-server /usr/local/bin/ncc-orchestrator \
    && mkdir -p /app/data/auth /app/outputfiles /app/nccfiles /app/logs /app/config \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 8081
# HEALTHCHECK uses the api-server's own --health-check mode (added in
# v2.0.2). Avoids needing wget/curl in the runtime image and reads the
# token file the api-server itself wrote, so probe and server share
# the same auth path.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/usr/local/bin/ncc-api-server", "--health-check", "--listen", "127.0.0.1:8081", "--token-file-path", "/app/data/auth/.ncc-api-token"]

ENTRYPOINT ["/usr/local/bin/ncc-api-server"]
CMD ["--listen", ":8081", "--repo-root", "/app", "--config-path", "/app/config/config.yaml", "--output-dir", "/app/outputfiles", "--log-dir", "/app/nccfiles", "--runner-log-path", "/app/logs/ncc-runner.log", "--token-file-path", "/app/data/auth/.ncc-api-token", "--orchestrator-bin", "/usr/local/bin/ncc-orchestrator", "--auth-mode", "token", "--cors-origin", "http://localhost:8080"]
