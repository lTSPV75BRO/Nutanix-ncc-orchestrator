FROM node:22-alpine AS frontend-builder

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM golang:1.26-alpine AS go-builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/ncc-ui-server ./cmd/ncc-ui-server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=go-builder /out/ncc-ui-server /usr/local/bin/ncc-ui-server
COPY --from=frontend-builder /frontend/dist /app/frontend/dist

RUN chmod 0755 /usr/local/bin/ncc-ui-server \
    && mkdir -p /app/data/auth \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/ncc-ui-server"]
CMD ["--listen", ":8080", "--dir", "/app/frontend/dist", "--backend-url", "http://ncc-api-server:8081", "--api-token-file", "/app/data/auth/.ncc-api-token", "--api-auth-mode", "token", "--allowed-origins", "http://localhost:8080"]
