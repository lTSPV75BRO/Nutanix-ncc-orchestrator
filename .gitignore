# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
.DS_Store
temp/
Changelog*
!CHANGELOG.md
config.yaml

# Logs and outputs from your tool
nccfiles/
outputfiles/
logs/
dist/
/frontend-dist/
k8s/configmap.yaml
k8s/secret.yaml

# Prometheus metrics
promfiles/

# Binaries (repo root only; do not use ncc-orchestrator* — it would ignore helm/ncc-orchestrator/)
/ncc-orchestrator
/ncc-orchestrator.exe
/ncc-api-server
/ncc-api-server.exe
/ncc-ui-server
/ncc-ui-server.exe
/goncc
/goncc.exe
ncc-mcp-server

# Frontend dependencies/cache
frontend/node_modules/
frontend/*.tsbuildinfo
/frontend/coverage/

# Local runtime state/secrets
.ncc-api-token
.ncc-api-schedule.json
.ncc-api-notifications.json
.ncc-preflight-check
.ncc-prefight-check

# Local scratch/temp files
.tmp_*
/.tmp-greenfield/

# Local packaged release bundles
ncc-v2-stack-*.tar.gz
ncc-v2-stack-*.zip

# Generated Windows VERSIONINFO resource files (produced from
# tools/winversioninfo as part of binaryGO.txt; arch-specific so
# they need to be regenerated each release)
*.syso

# Local cross-compile / deploy staging output (cross-compiled binaries,
# frontend dist copy, and the deploy tarball produced when shipping to a host)
/build/
/bin/